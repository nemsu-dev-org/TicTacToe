<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="30dp"
    android:background="@color/black"
    android:id="@+id/gameActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="visible"
        android:id="@+id/difficultyChoices">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/easyDifficulty"
            android:layout_marginBottom="40dp"
            android:layout_centerHorizontal="true"
            android:text="Difficulty"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:fontFamily="@font/public_pixel_rv0pa"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button"
            android:id="@+id/easyDifficulty"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="@color/blue"
            android:fontFamily="casual"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:text="Easy"
            android:textColor="@color/white"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_below="@+id/easyDifficulty"
            android:text="Hard"
            android:id="@+id/hardDifficulty"
            android:layout_marginTop="15dp"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/friday_terror"
            android:textStyle="bold"
            android:textSize="20sp"
            android:backgroundTint="@color/redOrange"
            android:textColor="@color/black"/>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/gameTilesLayout"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_above="@+id/tilesLayout"
            android:text="X's turns"
            android:gravity="center"
            android:textSize="25sp"
            android:layout_marginBottom="70dp"
            android:fontFamily="@font/public_pixel_rv0pa"
            android:textColor="@color/blue"
            android:id="@+id/turnsLabel"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:rowCount="3"
            android:columnCount="1"
            android:background="@color/black"
            android:id="@+id/tilesLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_column="0"
                android:layout_row="0">

                <Button
                    android:id="@+id/btn1"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn2"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn3"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_row="1">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn4"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn5"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn6"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_row="2">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn7"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn8"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    app:cornerRadius="10dp"
                    android:id="@+id/btn9"
                    android:backgroundTint="@color/dark"
                    android:textColor="@color/blue"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/public_pixel_rv0pa"/>

            </LinearLayout>

        </GridLayout>

    </RelativeLayout>

</RelativeLayout>
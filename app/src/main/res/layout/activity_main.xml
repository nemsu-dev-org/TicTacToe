<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/choicesLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="70dp"
        android:fontFamily="@font/friday_terror"
        android:text="TicTacToe"
        android:textColor="@color/redOrange"
        android:textSize="65sp"
        android:shadowColor="#8A8A8A"
        android:shadowDx="7"
        android:shadowDy="5"
        android:shadowRadius="3"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:id="@+id/choicesLayout">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="1 Player"
            android:id="@+id/singlePlayerButton"
            android:backgroundTint="@color/marine"
            android:textColor="@color/white"
            android:padding="10dp"/>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="2 Player"
            android:id="@+id/doublePlayerButton"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="@color/marine"
            android:textColor="@color/white"
            android:padding="10dp"/>


        <Button
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:id="@+id/exitButton"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"/>

    </LinearLayout>

</RelativeLayout>